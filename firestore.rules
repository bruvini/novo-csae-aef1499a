rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Portal data model (Standard Firestore):
    // usuarios/{authUid}: profile and approval/permission state.
    // pacientesProcessoEnfermagem/{id}: patient identifiers and clinical process history, owner in uidUsuario.
    // Catalogs: ExamesLabImagem, RevisaoSistemas, SinaisVitais, rolEnfermagem,
    // diagnosticosEnfermagem and subconjuntosEnfermagem.
    // Support: tickets_suporte and sugestoes_melhoria, owner in usuarioId; pesquisas_nps, owner in usuarioId.
    // Administrative: estatisticas, changelogs, intervencoesAutorais (author in autorId),
    // decisoesIntervencoes (immutable decisions linked to a suggestion).

    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(profilePath());
    }

    function profile() {
      return get(profilePath()).data;
    }

    function isApproved() {
      return hasProfile()
        && profile().statusAcesso in ['Aprovado', 'Liberado'];
    }

    function isActiveAdmin() {
      return hasProfile()
        && profile().statusAcesso in ['Aprovado', 'Liberado']
        && profile().ehAdmin == true;
    }

    function hasPage(pageId) {
      return isActiveAdmin()
        || (isApproved()
          && ((('paginasPermitidas' in profile())
                && profile().paginasPermitidas is list
                && pageId in profile().paginasPermitidas)
            || (pageId == 'ProcessoEnfermagem'
              && (!('paginasPermitidas' in profile())
                || (profile().paginasPermitidas is list && profile().paginasPermitidas.size() == 0)))));
    }

    function canManageContent() {
      return isActiveAdmin()
        || (isApproved() && profile().gestorConteudos == true
          && 'paginasPermitidas' in profile()
          && profile().paginasPermitidas is list
          && 'GestaoConteudos' in profile().paginasPermitidas);
    }

    function canManageSupport() {
      return hasPage('GestaoSuporte');
    }

    function canViewBI() {
      return isActiveAdmin();
    }

    function boundedString(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function validPersonalData(value) {
      return value is map
        && value.keys().hasAll(['nomeCompleto', 'rg', 'cpf', 'rua', 'numero', 'bairro', 'cidade', 'uf', 'cep'])
        && value.keys().hasOnly(['nomeCompleto', 'rg', 'cpf', 'rua', 'numero', 'bairro', 'cidade', 'uf', 'cep'])
        && boundedString(value.nomeCompleto, 160)
        && boundedString(value.rg, 32)
        && boundedString(value.cpf, 20)
        && boundedString(value.rua, 160)
        && boundedString(value.numero, 24)
        && boundedString(value.bairro, 100)
        && boundedString(value.cidade, 100)
        && boundedString(value.uf, 2)
        && boundedString(value.cep, 12);
    }

    function validProfessionalData(value) {
      return value is map
        && value.keys().hasAll(['formacao', 'atuaSMS'])
        && value.keys().hasOnly(['formacao', 'numeroCoren', 'ufCoren', 'dataInicioResidencia', 'iesEnfermagem', 'atuaSMS', 'lotacao', 'matricula', 'cidadeTrabalho', 'localCargo'])
        && boundedString(value.formacao, 120)
        && value.atuaSMS is bool
        && (!('numeroCoren' in value) || boundedString(value.numeroCoren, 40))
        && (!('ufCoren' in value) || boundedString(value.ufCoren, 2))
        && (!('dataInicioResidencia' in value) || boundedString(value.dataInicioResidencia, 40))
        && (!('iesEnfermagem' in value) || boundedString(value.iesEnfermagem, 180))
        && (!('lotacao' in value) || boundedString(value.lotacao, 140))
        && (!('matricula' in value) || boundedString(value.matricula, 40))
        && (!('cidadeTrabalho' in value) || boundedString(value.cidadeTrabalho, 100))
        && (!('localCargo' in value) || boundedString(value.localCargo, 140));
    }

    function validProfileDocument(data) {
      return data is map
        && data.keys().hasAll(['uid', 'email', 'dadosPessoais', 'dadosProfissionais', 'termoResponsabilidadeAceito', 'termoResponsabilidadeData', 'ehAdmin', 'gestorConteudos', 'tipoUsuario', 'statusAcesso', 'dataCadastro'])
        && data.keys().hasOnly(['uid', 'email', 'dadosPessoais', 'dadosProfissionais', 'termoResponsabilidadeAceito', 'termoResponsabilidadeData', 'ehAdmin', 'gestorConteudos', 'tipoUsuario', 'statusAcesso', 'dataCadastro', 'paginasPermitidas', 'totalAcessos', 'ultimoAcesso', 'historicoAcesso', 'dataAprovacao', 'dataRecusa', 'dataRecusaAcesso', 'dataLiberacaoAcesso', 'motivoRecusa', 'dataRevogacao', 'revogadoPorUid', 'dataRestauracao', 'dataAtualizacaoPrivilegios', 'alteracaoCadastralPendente', 'dataAlteracaoCadastral', 'dadosProfissionaisAnteriores', 'justificativaRecusaAlteracao', 'versaoPermissoes', 'historicoRevisoes', 'analisadoPor', 'analisadoPorUid', 'dataAtualizacaoDadosPessoais', 'dadosProfissionaisPropostos', 'dataRevisaoCadastral', 'revisadoPorUid', 'resultadoRevisaoCadastral', 'revisaoResidenciaEm', 'dataRevisaoResidencia', 'revisadoResidenciaPorUid', 'motivoRevogacao', 'historicoRevisoesResidencia'])
        && data.uid is string
        && boundedString(data.email, 254)
        && validPersonalData(data.dadosPessoais)
        && validProfessionalData(data.dadosProfissionais)
        && data.termoResponsabilidadeAceito is bool
        && data.termoResponsabilidadeData is timestamp
        && data.ehAdmin is bool
        && data.gestorConteudos is bool
        && data.tipoUsuario in ['Comum', 'Admin', 'Administrador']
        && data.statusAcesso in ['Aguardando', 'Liberado', 'Aprovado', 'Recusado', 'Rejeitado', 'Revogado', 'AguardandoRevisaoCadastro']
        && (!('paginasPermitidas' in data) || (data.paginasPermitidas is list
          && data.paginasPermitidas.size() <= 12
          && data.paginasPermitidas.hasOnly(['ProcessoEnfermagem', 'GestaoConteudos', 'GestaoUsuarios', 'PainelEstatistico', 'GestaoSuporte', 'Dashboard', 'CentralAjuda'])))
        && (!('totalAcessos' in data) || (data.totalAcessos is int && data.totalAcessos >= 0))
        && (!('ultimoAcesso' in data) || data.ultimoAcesso is timestamp)
        && (!('historicoAcesso' in data) || (data.historicoAcesso is list && data.historicoAcesso.size() <= 200))
        && (!('motivoRecusa' in data) || boundedString(data.motivoRecusa, 2000))
        && (!('dadosProfissionaisPropostos' in data) || validProfessionalData(data.dadosProfissionaisPropostos))
        && (!('alteracaoCadastralPendente' in data) || data.alteracaoCadastralPendente is bool)
        && (!('justificativaRecusaAlteracao' in data) || boundedString(data.justificativaRecusaAlteracao, 2000))
        && (!('dataAlteracaoCadastral' in data) || data.dataAlteracaoCadastral is timestamp)
        && (!('dataRevisaoCadastral' in data) || data.dataRevisaoCadastral is timestamp)
        && (!('revisadoPorUid' in data) || boundedString(data.revisadoPorUid, 128))
        && (!('resultadoRevisaoCadastral' in data) || data.resultadoRevisaoCadastral in ['Aprovada', 'Recusada'])
        && (!('historicoRevisoes' in data) || (data.historicoRevisoes is list && data.historicoRevisoes.size() <= 100))
        && (!('revisaoResidenciaEm' in data) || (data.revisaoResidenciaEm is string && data.revisaoResidenciaEm.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!('dataRevisaoResidencia' in data) || data.dataRevisaoResidencia is timestamp)
        && (!('revisadoResidenciaPorUid' in data) || boundedString(data.revisadoResidenciaPorUid, 128))
        && (!('motivoRevogacao' in data) || boundedString(data.motivoRevogacao, 600))
        && (!('historicoRevisoesResidencia' in data) || (data.historicoRevisoesResidencia is list && data.historicoRevisoesResidencia.size() <= 60));
    }

    function isPendingSelfRegistration(uid) {
      return signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        // Campos históricos são aceitos para preservar perfis antigos, mas não podem
        // ser forjados por quem está criando um cadastro novo.
        && request.resource.data.keys().hasOnly(['uid', 'email', 'dadosPessoais', 'dadosProfissionais', 'termoResponsabilidadeAceito', 'termoResponsabilidadeData', 'ehAdmin', 'gestorConteudos', 'tipoUsuario', 'statusAcesso', 'dataCadastro', 'paginasPermitidas'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.ehAdmin == false
        && request.resource.data.gestorConteudos == false
        && request.resource.data.tipoUsuario == 'Comum'
        && request.resource.data.statusAcesso == 'Aguardando'
        && request.resource.data.termoResponsabilidadeAceito == true
        && request.resource.data.termoResponsabilidadeData == request.time
        && request.resource.data.dataCadastro == request.time
        && (!('paginasPermitidas' in request.resource.data) || request.resource.data.paginasPermitidas.size() == 0)
        && validProfileDocument(request.resource.data);
    }

    function adminProfileUpdateIsSafe() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let privilegedFields = ['ehAdmin', 'tipoUsuario', 'gestorConteudos', 'paginasPermitidas', 'statusAcesso'];
      return changed.hasOnly(['ehAdmin', 'tipoUsuario', 'gestorConteudos', 'paginasPermitidas', 'statusAcesso', 'dataAprovacao', 'dataRecusa', 'dataRecusaAcesso', 'dataLiberacaoAcesso', 'motivoRecusa', 'dataRevogacao', 'revogadoPorUid', 'dataRestauracao', 'dataAtualizacaoPrivilegios', 'alteracaoCadastralPendente', 'dataAlteracaoCadastral', 'dadosProfissionaisAnteriores', 'justificativaRecusaAlteracao'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && validProfileDocument(request.resource.data)
        && (!(changed.hasAny(privilegedFields)) || resource.data.uid != request.auth.uid)
        && (!(request.resource.data.statusAcesso in ['Liberado', 'Aprovado']) || request.resource.data.ehAdmin is bool)
        && (!changed.hasAny(['dataAprovacao']) || request.resource.data.dataAprovacao == request.time)
        && (!changed.hasAny(['dataRecusa']) || request.resource.data.dataRecusa == request.time)
        && (!changed.hasAny(['dataRecusaAcesso']) || request.resource.data.dataRecusaAcesso == request.time)
        && (!changed.hasAny(['dataRevogacao']) || request.resource.data.dataRevogacao == request.time)
        && (!changed.hasAny(['dataRestauracao']) || request.resource.data.dataRestauracao == request.time)
        && (!changed.hasAny(['dataAtualizacaoPrivilegios']) || request.resource.data.dataAtualizacaoPrivilegios == request.time)
        && (!('revogadoPorUid' in request.resource.data) || request.resource.data.revogadoPorUid == request.auth.uid || request.resource.data.revogadoPorUid == resource.data.revogadoPorUid);
    }

    function ownerProfileUpdateIsSafe() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isApproved()
        && resource.data.uid == request.auth.uid
        && changed.hasOnly(['dadosPessoais', 'totalAcessos', 'ultimoAcesso', 'historicoAcesso'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.ehAdmin == resource.data.ehAdmin
        && request.resource.data.gestorConteudos == resource.data.gestorConteudos
        && request.resource.data.tipoUsuario == resource.data.tipoUsuario
        && request.resource.data.statusAcesso == resource.data.statusAcesso
        && validProfileDocument(request.resource.data)
        // Atualização cadastral direta limitada a endereço; dados de identidade e
        // vínculo exigem conferência da gestão. Evita autoalteração de COREN/lotação.
        && (!changed.hasAny(['dadosPessoais']) || (
          validPersonalData(request.resource.data.dadosPessoais)
          && request.resource.data.dadosPessoais.diff(resource.data.dadosPessoais)
            .affectedKeys().hasOnly(['rua', 'numero', 'bairro', 'cidade', 'uf', 'cep'])
        ))
        && (!changed.hasAny(['totalAcessos', 'ultimoAcesso', 'historicoAcesso'])
          || (request.resource.data.totalAcessos == (('totalAcessos' in resource.data) ? resource.data.totalAcessos : 0) + 1
            && request.resource.data.ultimoAcesso == request.time));
    }


    // Alteração de endereço/identidade só pelo proprietário autenticado.
    // CPF/RG exigem autenticação recente; acesso clínico permanece aprovado.
    function ownerIdentityUpdateIsSafe() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let personalChanged = request.resource.data.dadosPessoais.diff(resource.data.dadosPessoais).affectedKeys();
      return isApproved() && resource.data.uid == request.auth.uid
        && changed.hasOnly(['dadosPessoais', 'dataAtualizacaoDadosPessoais'])
        && validPersonalData(request.resource.data.dadosPessoais)
        && personalChanged.hasOnly(['rua', 'numero', 'bairro', 'cidade', 'uf', 'cep', 'cpf', 'rg'])
        && (request.resource.data.dataAtualizacaoDadosPessoais == request.time)
        && (!personalChanged.hasAny(['cpf','rg'])
          || (request.auth.token.auth_time is int
            && request.auth.token.auth_time >= request.time.toMillis() / 1000 - 600));
    }

    // E-mail é alterado no Firebase Authentication APÓS verificação do novo
    // endereço, nunca somente pelo Firestore. Auth impede duas contas
    // simultâneas com o mesmo e-mail no mesmo projeto.
    function ownerVerifiedEmailSyncIsSafe() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return signedIn() && resource.data.uid == request.auth.uid
        && changed.hasOnly(['email'])
        && request.auth.token.email_verified == true
        && request.resource.data.email == request.auth.token.email
        && boundedString(request.resource.data.email, 254);
    }

    // Proposta profissional não altera o perfil vigente: bloqueia o acesso
    // imediatamente no mesmo commit e aguarda avaliação administrativa.
    function ownerProfessionalRequestIsSafe() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isApproved()
        && resource.data.uid == request.auth.uid
        && resource.data.ehAdmin == false
        && resource.data.statusAcesso in ['Aprovado', 'Liberado']
        && !('dadosProfissionaisPropostos' in resource.data
          && 'alteracaoCadastralPendente' in resource.data
          && resource.data.alteracaoCadastralPendente == true)
        && changed.hasOnly([
          'dadosProfissionaisPropostos', 'statusAcesso',
          'alteracaoCadastralPendente', 'dataAlteracaoCadastral'
        ])
        && request.resource.data.statusAcesso == 'AguardandoRevisaoCadastro'
        && request.resource.data.alteracaoCadastralPendente == true
        && validProfessionalData(request.resource.data.dadosProfissionaisPropostos)
        && request.resource.data.dadosProfissionaisPropostos != resource.data.dadosProfissionais
        && request.resource.data.dataAlteracaoCadastral == request.time;
    }

    function adminProfessionalReviewIsSafe() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let accepted = request.resource.data.resultadoRevisaoCadastral == 'Aprovada';
      let rejected = request.resource.data.resultadoRevisaoCadastral == 'Recusada';
      return isActiveAdmin() && request.auth.uid != resource.data.uid
        && resource.data.statusAcesso == 'AguardandoRevisaoCadastro'
        && resource.data.alteracaoCadastralPendente == true
        && changed.hasOnly([
          'dadosProfissionais', 'dadosProfissionaisAnteriores',
          'alteracaoCadastralPendente', 'statusAcesso', 'dataAprovacao',
          'dataRecusa', 'motivoRecusa', 'justificativaRecusaAlteracao',
          'dataRevisaoCadastral', 'revisadoPorUid', 'resultadoRevisaoCadastral',
          'historicoRevisoes'
        ])
        && validProfessionalData(request.resource.data.dadosProfissionais)
        && request.resource.data.dataRevisaoCadastral == request.time
        && request.resource.data.revisadoPorUid == request.auth.uid
        && request.resource.data.alteracaoCadastralPendente == false
        && request.resource.data.historicoRevisoes is list
        && request.resource.data.historicoRevisoes.size() <= 100
        && request.resource.data.historicoRevisoes.size() ==
           (('historicoRevisoes' in resource.data) ? resource.data.historicoRevisoes.size() : 0) + 1
        && (accepted
          ? (request.resource.data.statusAcesso == 'Liberado'
             && request.resource.data.dadosProfissionais == resource.data.dadosProfissionaisPropostos
             && request.resource.data.dadosProfissionaisAnteriores == resource.data.dadosProfissionais
             && request.resource.data.dataAprovacao == request.time)
          : (rejected
             && request.resource.data.statusAcesso == 'Recusado'
             && request.resource.data.dadosProfissionais == resource.data.dadosProfissionais
             && boundedString(request.resource.data.motivoRecusa, 2000)
             && request.resource.data.motivoRecusa.size() >= 8
             && request.resource.data.justificativaRecusaAlteracao == request.resource.data.motivoRecusa
             && request.resource.data.dataRecusa == request.time));
    }


    function residentReviewBase() {
      return request.auth.uid != resource.data.uid
        && resource.data.ehAdmin == false
        && resource.data.statusAcesso in ['Aprovado', 'Liberado']
        && resource.data.dadosProfissionais.formacao == 'Residente de Enfermagem'
        && resource.data.dadosProfissionais.dataInicioResidencia is string
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.dataRevisaoResidencia == request.time
        && request.resource.data.revisadoResidenciaPorUid == request.auth.uid;
    }

    function residentHistorySafe(action, result) {
      let oldList = ('historicoRevisoesResidencia' in resource.data)
        ? resource.data.historicoRevisoesResidencia : [];
      let newList = request.resource.data.historicoRevisoesResidencia;
      let last = newList[newList.size() - 1];
      return newList is list && oldList is list
        && newList.size() == oldList.size() + 1 && newList.size() <= 60
        && newList.hasAll(oldList)
        && last is map
        && last.keys().hasAll(['acao','revisorUid','decididoEm','inicioResidencia','marcoDoisAnos',
          'statusResultante','motivo','proximoPrazo','diasProrrogados','vinculoSMS','lotacao','matricula'])
        && last.acao == action && last.statusResultante == result
        && last.revisorUid == request.auth.uid
        && last.inicioResidencia == resource.data.dadosProfissionais.dataInicioResidencia
        && last.marcoDoisAnos is string
        && last.decididoEm is timestamp
        && boundedString(last.motivo, 600)
        && boundedString(last.proximoPrazo, 10)
        && last.diasProrrogados is int
        && last.vinculoSMS is bool
        && boundedString(last.lotacao, 140)
        && boundedString(last.matricula, 40);
    }

    function adminExtendResident() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let entries = request.resource.data.historicoRevisoesResidencia;
      let last = entries[entries.size() - 1];
      return changed.hasOnly(['revisaoResidenciaEm','historicoRevisoesResidencia',
        'dataRevisaoResidencia','revisadoResidenciaPorUid'])
        && residentReviewBase()
        && request.resource.data.revisaoResidenciaEm is string
        && request.resource.data.revisaoResidenciaEm.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && residentHistorySafe('Prorrogado','Liberado')
        && last.proximoPrazo == request.resource.data.revisaoResidenciaEm
        && last.diasProrrogados >= 1 && last.diasProrrogados <= 730
        && last.vinculoSMS == resource.data.dadosProfissionais.atuaSMS
        && last.lotacao == resource.data.dadosProfissionais.get('lotacao','')
        && last.matricula == resource.data.dadosProfissionais.get('matricula','');
    }


    function adminRevokeResident() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let old = resource.data.get('historicoRevisoesResidencia', []);
      let events = request.resource.data.historicoRevisoesResidencia;
      return changed.hasOnly(['statusAcesso','historicoRevisoesResidencia',
        'dataRevisaoResidencia','revisadoResidenciaPorUid',
        'motivoRevogacao','dataRevogacao','revogadoPorUid'])
        && residentReviewBase()
        && request.resource.data.statusAcesso == 'Revogado'
        && request.resource.data.motivoRevogacao ==
          'Fim da residência e não inclusão no quadro de profissionais da rede.'
        && request.resource.data.dataRevogacao == request.time
        && request.resource.data.revogadoPorUid == request.auth.uid
        && events is list && events.size() == old.size() + 1 && events.hasAll(old)
        && events[events.size()-1].acao == 'Revogado'
        && events[events.size()-1].revisorUid == request.auth.uid;
    }


    function adminConvertResident() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let professional = request.resource.data.dadosProfissionais;
      let result = professional.atuaSMS ? 'Liberado' : 'Revogado';
      let old = resource.data.get('historicoRevisoesResidencia', []);
      let events = request.resource.data.historicoRevisoesResidencia;
      return changed.hasOnly(['dadosProfissionais','statusAcesso','historicoRevisoesResidencia',
        'dataRevisaoResidencia','revisadoResidenciaPorUid',
        'motivoRevogacao','dataRevogacao','revogadoPorUid'])
        && residentReviewBase()
        && professional.diff(resource.data.dadosProfissionais).affectedKeys()
          .hasOnly(['formacao','atuaSMS','lotacao','matricula'])
        && professional.formacao == 'Enfermeiro'
        && request.resource.data.statusAcesso == result
        && (professional.atuaSMS
           ? (boundedString(professional.lotacao, 140) && professional.lotacao.size() > 0
             && boundedString(professional.matricula, 40) && professional.matricula.size() > 0)
           : (professional.get('lotacao', '') == '' && professional.get('matricula', '') == ''
             && request.resource.data.motivoRevogacao is string
             && request.resource.data.dataRevogacao == request.time
             && request.resource.data.revogadoPorUid == request.auth.uid))
        && events is list && events.size() == old.size() + 1 && events.hasAll(old)
        && events[events.size()-1].acao == 'Convertido'
        && events[events.size()-1].statusResultante == result
        && events[events.size()-1].revisorUid == request.auth.uid;
    }

    function ownPatient() {
      return isApproved() && hasPage('ProcessoEnfermagem') && resource.data.uidUsuario == request.auth.uid;
    }

    function validNewPatient() {
      return request.resource.data.keys().hasAll(['nomeCompleto', 'dataNascimento', 'sexo', 'dataCadastro', 'uidUsuario', 'processosEnfermagem'])
        && request.resource.data.keys().hasOnly(['nomeCompleto', 'dataNascimento', 'sexo', 'dataCadastro', 'uidUsuario', 'idUsuario', 'processosEnfermagem'])
        && boundedString(request.resource.data.nomeCompleto, 160)
        && request.resource.data.dataNascimento is timestamp
        && request.resource.data.sexo in ['Feminino', 'Masculino']
        && request.resource.data.dataCadastro == request.time
        && request.resource.data.uidUsuario == request.auth.uid
        && request.resource.data.processosEnfermagem is list
        && request.resource.data.processosEnfermagem.size() == 0
        && (!('idUsuario' in request.resource.data) || boundedString(request.resource.data.idUsuario, 128));
    }

    function validTicketCreate() {
      return request.resource.data.keys().hasAll(['usuarioId', 'nomeUsuario', 'moduloAferido', 'descricao', 'status', 'visualizadoPeloSuporte', 'dataCriacao'])
        && request.resource.data.keys().hasOnly(['usuarioId', 'nomeUsuario', 'moduloAferido', 'descricao', 'status', 'visualizadoPeloSuporte', 'dataCriacao'])
        && request.resource.data.usuarioId == request.auth.uid
        && boundedString(request.resource.data.nomeUsuario, 160)
        && boundedString(request.resource.data.moduloAferido, 100)
        && boundedString(request.resource.data.descricao, 10000)
        && request.resource.data.status == 'Aberto'
        && request.resource.data.visualizadoPeloSuporte == false
        && request.resource.data.dataCriacao == request.time;
    }

    function validSuggestionCreate() {
      return request.resource.data.keys().hasAll(['usuarioId', 'nomeUsuario', 'categoria', 'descricao', 'visualizadoPeloSuporte', 'dataCriacao'])
        && request.resource.data.keys().hasOnly(['usuarioId', 'nomeUsuario', 'categoria', 'descricao', 'visualizadoPeloSuporte', 'dataCriacao'])
        && request.resource.data.usuarioId == request.auth.uid
        && boundedString(request.resource.data.nomeUsuario, 160)
        && boundedString(request.resource.data.categoria, 100)
        && boundedString(request.resource.data.descricao, 10000)
        && request.resource.data.visualizadoPeloSuporte == false
        && request.resource.data.dataCriacao == request.time;
    }

    function validNpsCreate() {
      return request.resource.data.keys().hasAll(['usuarioId', 'nomeUsuario', 'notaGeral', 'notaUsabilidade', 'notaPerformance', 'dataCriacao'])
        && request.resource.data.keys().hasOnly(['usuarioId', 'nomeUsuario', 'notaGeral', 'notaUsabilidade', 'notaPerformance', 'comentario', 'dataCriacao'])
        && request.resource.data.usuarioId == request.auth.uid
        && boundedString(request.resource.data.nomeUsuario, 160)
        && request.resource.data.notaGeral is int && request.resource.data.notaGeral >= 1 && request.resource.data.notaGeral <= 10
        && request.resource.data.notaUsabilidade is int && request.resource.data.notaUsabilidade >= 1 && request.resource.data.notaUsabilidade <= 10
        && request.resource.data.notaPerformance is int && request.resource.data.notaPerformance >= 1 && request.resource.data.notaPerformance <= 10
        && (!('comentario' in request.resource.data) || boundedString(request.resource.data.comentario, 5000))
        && (request.resource.data.notaGeral > 6
          || ('comentario' in request.resource.data && request.resource.data.comentario is string && request.resource.data.comentario.size() > 0))
        && request.resource.data.dataCriacao == request.time;
    }

    function validCatalogDocument(catalog) {
      let data = request.resource.data;
      return data is map && data.keys().size() <= 32
        && ((catalog == 'ExamesLabImagem'
          && data.keys().hasAll(['nomeExame', 'descricaoExame', 'tipoExame', 'componentes'])
          && data.keys().hasOnly(['nomeExame', 'descricaoExame', 'tipoExame', 'componentes', 'dataCadastro'])
          && boundedString(data.nomeExame, 180)
          && boundedString(data.descricaoExame, 2000)
          && data.tipoExame in ['Laboratorial', 'Imagem']
          && data.componentes is list && data.componentes.size() <= 100)
        || (catalog == 'SinaisVitais'
          && data.keys().hasAll(['sinalVitalNome', 'sinalVitalDescricao', 'unidadeMedida', 'valoresDeReferencia'])
          && data.keys().hasOnly(['sinalVitalNome', 'sinalVitalDescricao', 'unidadeMedida', 'valoresDeReferencia', 'dataCadastro'])
          && boundedString(data.sinalVitalNome, 180)
          && boundedString(data.sinalVitalDescricao, 2000)
          && boundedString(data.unidadeMedida, 100)
          && data.valoresDeReferencia is list && data.valoresDeReferencia.size() <= 200)
        || (catalog == 'RevisaoSistemas'
          && data.keys().hasAll(['nomeSistema', 'descricaoSistema', 'exames'])
          && data.keys().hasOnly(['nomeSistema', 'descricaoSistema', 'exames', 'dataCadastro'])
          && boundedString(data.nomeSistema, 180)
          && boundedString(data.descricaoSistema, 2000)
          && data.exames is list && data.exames.size() <= 100)
        || (catalog == 'rolEnfermagem'
          && data.keys().hasAll(['tituloDiagnostico', 'descricaoDiagnostico', 'subconjuntos', 'resultadosEsperados'])
          && data.keys().hasOnly(['tituloDiagnostico', 'descricaoDiagnostico', 'subconjuntos', 'resultadosEsperados', 'dataCadastro', 'ultimaSugestaoPublicada'])
          && boundedString(data.tituloDiagnostico, 300)
          && boundedString(data.descricaoDiagnostico, 5000)
          && data.subconjuntos is list && data.subconjuntos.size() <= 100
          && data.resultadosEsperados is list && data.resultadosEsperados.size() <= 100
          && (!('ultimaSugestaoPublicada' in data) || boundedString(data.ultimaSugestaoPublicada, 128)))
        || (catalog == 'diagnosticosEnfermagem'
          && data.keys().hasAll(['tituloDiagnostico', 'subconjuntosVinculados', 'resultadosEsperados'])
          && data.keys().hasOnly(['tituloDiagnostico', 'descricaoDiagnostico', 'subconjuntosVinculados', 'resultadosEsperados', 'dataCadastro'])
          && boundedString(data.tituloDiagnostico, 300)
          && (!('descricaoDiagnostico' in data) || boundedString(data.descricaoDiagnostico, 5000))
          && data.subconjuntosVinculados is list && data.subconjuntosVinculados.size() <= 100
          && data.resultadosEsperados is list && data.resultadosEsperados.size() <= 100)
        || (catalog == 'subconjuntosEnfermagem'
          && data.keys().hasAll(['tipoSubconjunto', 'tituloSubconjunto'])
          && data.keys().hasOnly(['tipoSubconjunto', 'tituloSubconjunto', 'descricaoSubconjunto', 'volumeProtocolo', 'versaoProtocolo', 'dataPublicacaoProtocolo', 'dataAtualizacaoProtocolo', 'urlProtocolo', 'imagemCapaProtocolo', 'dataCadastro'])
          && boundedString(data.tipoSubconjunto, 100)
          && boundedString(data.tituloSubconjunto, 300)
          && (!('descricaoSubconjunto' in data) || boundedString(data.descricaoSubconjunto, 10000))
          && (!('urlProtocolo' in data) || boundedString(data.urlProtocolo, 2048))
          && (!('imagemCapaProtocolo' in data) || boundedString(data.imagemCapaProtocolo, 2048))));
    }

    match /usuarios/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isActiveAdmin());
      allow list: if isActiveAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isPendingSelfRegistration(uid);
      allow update: if (isActiveAdmin() && (adminExtendResident() || adminRevokeResident() || adminConvertResident() || adminProfileUpdateIsSafe() || adminProfessionalReviewIsSafe()))
        || (signedIn() && (ownerProfileUpdateIsSafe() || ownerIdentityUpdateIsSafe()
          || ownerVerifiedEmailSyncIsSafe() || ownerProfessionalRequestIsSafe()));
      allow delete: if false;
    }

    // Eventos novos são imutáveis e vinculados ao incremento na mesma transação.
    // A origem cliente não comprova, por si só, uma autenticação real.
    match /eventosAcesso/{eventoId} {
      allow read: if canViewBI();
      allow create: if isApproved()
        && request.resource.data.keys().hasOnly(['uid', 'numero', 'dia', 'dataHora'])
        && request.resource.data.keys().hasAll(['uid', 'numero', 'dia', 'dataHora'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.numero is int && request.resource.data.numero > 0
        && eventoId == request.auth.uid + '_' + string(request.resource.data.numero)
        && request.resource.data.dataHora == request.time
        && request.resource.data.dia is string
        && request.resource.data.dia.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && getAfter(/databases/$(database)/documents/acessosDiarios/$(request.resource.data.dia)).data.ultimoEvento == eventoId
        && getAfter(profilePath()).data.totalAcessos == request.resource.data.numero
        && getAfter(profilePath()).data.ultimoAcesso == request.time
        && request.resource.data.numero == (('totalAcessos' in profile()) ? profile().totalAcessos : 0) + 1;
      allow update, delete: if false;
    }

    match /acessosDiarios/{dia} {
      allow read: if canViewBI();
      allow create, update: if isApproved()
        && dia.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.keys().hasAll(['dia', 'total', 'ultimoEvento'])
        && request.resource.data.keys().hasOnly(['dia', 'total', 'ultimoEvento'])
        && request.resource.data.dia == dia
        && request.resource.data.total is int
        && request.resource.data.total == (resource == null ? 0 : resource.data.total) + 1
        && request.resource.data.ultimoEvento == request.auth.uid + '_' + string(getAfter(profilePath()).data.totalAcessos)
        && getAfter(/databases/$(database)/documents/eventosAcesso/$(request.resource.data.ultimoEvento)).data.dia == dia;
      allow delete: if false;
    }

    match /pacientesProcessoEnfermagem/{patientId} {
      allow read: if ownPatient() || (isActiveAdmin() && canViewBI());
      allow create: if isApproved() && hasPage('ProcessoEnfermagem') && validNewPatient();
      allow update: if ownPatient()
        && request.resource.data.uidUsuario == resource.data.uidUsuario
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nomeCompleto', 'dataNascimento', 'sexo', 'processosEnfermagem'])
        && boundedString(request.resource.data.nomeCompleto, 160)
        && request.resource.data.dataNascimento is timestamp
        && request.resource.data.sexo in ['Feminino', 'Masculino']
        && request.resource.data.processosEnfermagem is list
        && request.resource.data.processosEnfermagem.size() <= 50;
      allow delete: if ownPatient();
    }

    // Reservas imutáveis para novos nomes; transações gravam a reserva e o
    // documento clínico juntos. Conteúdos preexistentes seguem o preflight.
    match /identidadesCatalogoClinico/{chave} {
      allow get: if canManageContent();
      allow list: if false;
      allow create: if canManageContent()
        && request.resource.data.keys().hasAll(['chave', 'colecaoOrigem', 'documentoId', 'criadoEm'])
        && request.resource.data.keys().hasOnly(['chave', 'colecaoOrigem', 'documentoId', 'criadoEm'])
        && request.resource.data.chave == chave
        && boundedString(chave, 1400)
        && request.resource.data.colecaoOrigem in ['SinaisVitais', 'ExamesLabImagem', 'RevisaoSistemas']
        && boundedString(request.resource.data.documentoId, 128)
        && request.resource.data.documentoId.size() > 0
        && request.resource.data.criadoEm == request.time;
      allow update, delete: if false;
    }

    match /{catalog}/{documentId} {
      allow read: if catalog in ['ExamesLabImagem', 'RevisaoSistemas', 'SinaisVitais', 'rolEnfermagem', 'diagnosticosEnfermagem', 'subconjuntosEnfermagem']
        && (hasPage('ProcessoEnfermagem') || canManageContent());
      allow create: if catalog in ['ExamesLabImagem', 'RevisaoSistemas', 'SinaisVitais', 'rolEnfermagem', 'diagnosticosEnfermagem', 'subconjuntosEnfermagem']
        && canManageContent()
        && validCatalogDocument(catalog)
        && (!('dataCadastro' in request.resource.data) || request.resource.data.dataCadastro is timestamp);
      allow update: if catalog in ['ExamesLabImagem', 'RevisaoSistemas', 'SinaisVitais', 'rolEnfermagem', 'diagnosticosEnfermagem', 'subconjuntosEnfermagem']
        && canManageContent()
        && validCatalogDocument(catalog)
        && (('dataCadastro' in resource.data && request.resource.data.dataCadastro == resource.data.dataCadastro)
          || (!('dataCadastro' in resource.data) && !('dataCadastro' in request.resource.data)));
      // Conteúdos clínicos utilizados como chaves de prontuários não podem
      // ser excluídos diretamente (nem por SDK); migração/arquivamento exige
      // fluxo versionado e revisão institucional.
      allow delete: if catalog in ['rolEnfermagem', 'diagnosticosEnfermagem', 'subconjuntosEnfermagem']
        && canManageContent();
    }

    match /estatisticas/{reportId} {
      allow read: if canViewBI() && reportId in ['painel_usuarios', 'painel_processos'];
      allow create, update: if canViewBI() && reportId in ['painel_usuarios', 'painel_processos']
        && request.resource.data is map
        && request.resource.data.keys().size() <= 64;
      allow delete: if canViewBI() && reportId in ['painel_usuarios', 'painel_processos'];
    }

    // Cache segmentado do BI: somente administradores podem consultar e atualizar.
    // Os registros de produção não ficam acessíveis a profissionais comuns.
    match /estatisticas/painel_processos/lotacoes/{lotacaoId} {
      allow get, list: if canViewBI();
      allow create, update: if canViewBI()
        && request.resource.data.keys().hasOnly(['schemaVersion', 'lotacao', 'agregado'])
        && request.resource.data.keys().hasAll(['schemaVersion', 'lotacao', 'agregado'])
        && request.resource.data.schemaVersion is int
        && boundedString(request.resource.data.lotacao, 160)
        && request.resource.data.agregado is map;
      allow delete: if false;
    }

    match /estatisticas/painel_processos/registros/{chunkId} {
      allow get, list: if canViewBI();
      allow create, update: if canViewBI()
        && chunkId.matches('chunk-[0-9]{4}')
        && request.resource.data.keys().hasOnly(['schemaVersion', 'index', 'registros'])
        && request.resource.data.keys().hasAll(['schemaVersion', 'index', 'registros'])
        && request.resource.data.schemaVersion is int
        && request.resource.data.index is int
        && request.resource.data.registros is list
        && request.resource.data.registros.size() <= 600;
      allow delete: if false;
    }

    match /changelogs/{entryId} {
      allow read: if isApproved() || isActiveAdmin();
      allow create: if isActiveAdmin()
        && request.resource.data.keys().hasAll(['titulo', 'descricao', 'dataHora'])
        && request.resource.data.keys().hasOnly(['titulo', 'descricao', 'dataHora'])
        && boundedString(request.resource.data.titulo, 180)
        && boundedString(request.resource.data.descricao, 5000)
        && request.resource.data.dataHora is timestamp;
      allow update, delete: if false;
    }

    match /tickets_suporte/{ticketId} {
      allow get, list: if canManageSupport() || (isApproved() && resource.data.usuarioId == request.auth.uid);
      allow create: if isApproved() && validTicketCreate();
      allow update: if canManageSupport()
        ? (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respostaAdmin', 'visualizadoPeloSuporte', 'dataVisualizacaoSuporte', 'respostaVisualizadaPeloUsuario', 'dataRespostaAdmin', 'dataResolucao'])
          && (!('respostaAdmin' in request.resource.data) || boundedString(request.resource.data.respostaAdmin, 5000))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
            || (resource.data.status == 'Aberto' && request.resource.data.status == 'Resolvido'))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['dataRespostaAdmin']) || request.resource.data.dataRespostaAdmin == request.time)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['dataResolucao']) || request.resource.data.dataResolucao == request.time)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['dataVisualizacaoSuporte']) || request.resource.data.dataVisualizacaoSuporte == request.time)
          && request.resource.data.status in ['Aberto', 'Resolvido'])
        : (isApproved() && resource.data.usuarioId == request.auth.uid
          && resource.data.respostaAdmin is string
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['respostaVisualizadaPeloUsuario', 'dataVisualizacaoResposta'])
          && request.resource.data.respostaVisualizadaPeloUsuario == true
          && request.resource.data.dataVisualizacaoResposta == request.time);
      allow delete: if false;
    }

    match /sugestoes_melhoria/{suggestionId} {
      allow get, list: if canManageSupport() || (isApproved() && resource.data.usuarioId == request.auth.uid);
      allow create: if isApproved() && validSuggestionCreate();
      allow update: if canManageSupport()
        ? (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['respostaAdmin', 'visualizadoPeloSuporte', 'dataVisualizacaoSuporte', 'respostaVisualizadaPeloUsuario', 'dataRespostaAdmin', 'dataVisualizacaoResposta'])
          && (!('respostaAdmin' in request.resource.data) || boundedString(request.resource.data.respostaAdmin, 5000))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['dataRespostaAdmin']) || request.resource.data.dataRespostaAdmin == request.time)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['dataVisualizacaoSuporte']) || request.resource.data.dataVisualizacaoSuporte == request.time))
        : (isApproved() && resource.data.usuarioId == request.auth.uid
          && resource.data.respostaAdmin is string
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['respostaVisualizadaPeloUsuario', 'dataVisualizacaoResposta'])
          && request.resource.data.respostaVisualizadaPeloUsuario == true
          && request.resource.data.dataVisualizacaoResposta == request.time);
      allow delete: if false;
    }

    match /pesquisas_nps/{surveyId} {
      allow get, list: if canManageSupport() || (isApproved() && resource.data.usuarioId == request.auth.uid);
      allow create: if isApproved() && validNpsCreate();
      allow update, delete: if false;
    }

    function validSuggestion(data) {
      return data is map
        && data.keys().hasAll(['textoIntervencao', 'tituloResultadoVinculado', 'autorId', 'autorNome', 'dataCriacao'])
        && data.keys().hasOnly(['textoIntervencao', 'tituloResultadoVinculado', 'autorId', 'autorNome', 'autorNomeResolvido', 'origemStatus', 'dataCriacao', 'tituloResultadoOrigem', 'diagnosticoOrigemId', 'tituloDiagnosticoOrigem', 'identificadorSugestao', 'status', 'preparacao', 'categoriaRejeicao', 'justificativaRejeicao', 'avaliadorId', 'avaliadorNome', 'dataDecisao', 'ultimaDecisaoId', 'divisao', 'derivacao', 'tipoRegistro', 'avaliacaoQualidade', 'intervencaoBibliotecaId', 'grupoOperacaoId'])
        && boundedString(data.textoIntervencao, 2000) && data.textoIntervencao.size() > 0
        && boundedString(data.tituloResultadoVinculado, 500)
        && boundedString(data.autorId, 128) && data.autorId.size() > 0
        && boundedString(data.autorNome, 160)
        && (!('autorNomeResolvido' in data) || boundedString(data.autorNomeResolvido, 160))
        && (!('origemStatus' in data) || data.origemStatus in ['confirmada', 'ambigua', 'nao_recuperavel'])
        && data.dataCriacao is timestamp
        && (!('tituloResultadoOrigem' in data) || boundedString(data.tituloResultadoOrigem, 500))
        && (!('diagnosticoOrigemId' in data) || boundedString(data.diagnosticoOrigemId, 128))
        && (!('tituloDiagnosticoOrigem' in data) || boundedString(data.tituloDiagnosticoOrigem, 300))
        && (!('identificadorSugestao' in data) || boundedString(data.identificadorSugestao, 128))
        && (!('status' in data) || data.status in ['aguardando', 'aprovada', 'rejeitada'])
        && (!('preparacao' in data) || validPreparation(data.preparacao))
        && (!('categoriaRejeicao' in data) || data.categoriaRejeicao in ['Já existente no catálogo', 'Outra categoria profissional', 'Não contemplada nos protocolos municipais', 'Fundamentação insuficiente', 'Incompatível com diagnóstico', 'Incompatível com resultado', 'Risco à segurança do paciente', 'Redação incompleta', 'Duplicada', 'Fora do Processo de Enfermagem', 'Outro motivo'])
        && (!('justificativaRejeicao' in data) || boundedString(data.justificativaRejeicao, 2000))
        && (!('avaliadorId' in data) || boundedString(data.avaliadorId, 128))
        && (!('avaliadorNome' in data) || boundedString(data.avaliadorNome, 160))
        && (!('dataDecisao' in data) || data.dataDecisao is timestamp)
        && (!('ultimaDecisaoId' in data) || boundedString(data.ultimaDecisaoId, 128))
        && (!('intervencaoBibliotecaId' in data) || boundedString(data.intervencaoBibliotecaId, 128))
        && (!('grupoOperacaoId' in data) || boundedString(data.grupoOperacaoId, 128));
    }

    function validPreparation(data) {
      return data is map
        && data.keys().hasAll(['acaoPrescrita', 'acaoEnfermeiro', 'destinos'])
        && data.keys().hasOnly(['acaoPrescrita', 'acaoEnfermeiro', 'destinos', 'modoDisponibilidade', 'materiaisDeApoio', 'referenciaDeliberacao', 'dataDeliberacao', 'documentoHomologacao', 'responsavelValidacao'])
        && boundedString(data.acaoPrescrita, 1000) && data.acaoPrescrita.size() > 0
        && boundedString(data.acaoEnfermeiro, 1000) && data.acaoEnfermeiro.size() > 0
        && data.destinos is list && data.destinos.size() <= 1000
        && (!('modoDisponibilidade' in data) || data.modoDisponibilidade in ['resultados_especificos', 'transversal'])
        && ((('modoDisponibilidade' in data) && data.modoDisponibilidade == 'transversal' && data.destinos.size() == 0)
          || ((!('modoDisponibilidade' in data) || data.modoDisponibilidade == 'resultados_especificos') && data.destinos.size() > 0))
        && (!('materiaisDeApoio' in data) || (data.materiaisDeApoio is list && data.materiaisDeApoio.size() <= 20))
        && (!('referenciaDeliberacao' in data) || boundedString(data.referenciaDeliberacao, 300))
        && (!('dataDeliberacao' in data) || boundedString(data.dataDeliberacao, 20))
        && (!('documentoHomologacao' in data) || boundedString(data.documentoHomologacao, 300))
        && (!('responsavelValidacao' in data) || boundedString(data.responsavelValidacao, 160));
    }

    function validSuggestionUpdate(interventionId) {
      let data = request.resource.data;
      let previous = resource.data;
      let oldStatus = ('status' in previous) ? previous.status : 'aguardando';
      let audit = getAfter(/databases/$(database)/documents/decisoesIntervencoes/$(data.ultimaDecisaoId)).data;
      // Os campos clínicos e de autoria já foram validados na criação e são
      // imutáveis; validar novamente o mapa inteiro excede o limite de
      // expressões do Emulator em operações atômicas com o catálogo.
      return oldStatus == 'aguardando'
        && !('divisao' in previous)
        && data.keys().hasOnly(['textoIntervencao', 'tituloResultadoVinculado', 'autorId', 'autorNome', 'autorNomeResolvido', 'origemStatus', 'dataCriacao', 'tituloResultadoOrigem', 'diagnosticoOrigemId', 'tituloDiagnosticoOrigem', 'identificadorSugestao', 'status', 'preparacao', 'categoriaRejeicao', 'justificativaRejeicao', 'avaliadorId', 'avaliadorNome', 'dataDecisao', 'ultimaDecisaoId', 'derivacao', 'tipoRegistro', 'avaliacaoQualidade', 'intervencaoBibliotecaId', 'grupoOperacaoId'])
        && data.diff(previous).affectedKeys().hasOnly(['status', 'preparacao', 'categoriaRejeicao', 'justificativaRejeicao', 'avaliadorId', 'avaliadorNome', 'dataDecisao', 'ultimaDecisaoId', 'intervencaoBibliotecaId', 'grupoOperacaoId'])
        && data.status in ['aguardando', 'aprovada', 'rejeitada']
        && (!('preparacao' in data) || validPreparation(data.preparacao))
        && (!('categoriaRejeicao' in data) || data.categoriaRejeicao in ['Já existente no catálogo', 'Outra categoria profissional', 'Não contemplada nos protocolos municipais', 'Fundamentação insuficiente', 'Incompatível com diagnóstico', 'Incompatível com resultado', 'Risco à segurança do paciente', 'Redação incompleta', 'Duplicada', 'Fora do Processo de Enfermagem', 'Outro motivo'])
        && (!('justificativaRejeicao' in data) || boundedString(data.justificativaRejeicao, 2000))
        && data.avaliadorId == request.auth.uid
        && boundedString(data.avaliadorNome, 160) && data.avaliadorNome.size() > 0
        && data.dataDecisao == request.time
        && boundedString(data.ultimaDecisaoId, 128)
        && audit.sugestaoId == interventionId
        && audit.statusAnterior == oldStatus
        && audit.statusNovo == data.status
        && audit.avaliadorId == request.auth.uid
        && audit.dataHora == request.time
        && ((data.status == 'aguardando' && 'preparacao' in data && audit.tipo == 'preparar')
          || (data.status == 'rejeitada' && audit.tipo == 'rejeitar'
            && 'categoriaRejeicao' in data && 'justificativaRejeicao' in data
            && data.justificativaRejeicao.size() > 0)
          || (data.status == 'aprovada' && audit.tipo == 'publicar'
            && 'preparacao' in data && 'intervencaoBibliotecaId' in data
            && audit.intervencaoBibliotecaId == data.intervencaoBibliotecaId
            && getAfter(/databases/$(database)/documents/intervencoesBiblioteca/$(data.intervencaoBibliotecaId)).data.status == 'disponivel'
            && interventionId in getAfter(/databases/$(database)/documents/intervencoesBiblioteca/$(data.intervencaoBibliotecaId)).data.sugestoesOrigemIds
            && getAfter(/databases/$(database)/documents/intervencoesBiblioteca/$(data.intervencaoBibliotecaId)).data.acaoPrescrita == data.preparacao.acaoPrescrita
            && getAfter(/databases/$(database)/documents/intervencoesBiblioteca/$(data.intervencaoBibliotecaId)).data.acaoEnfermeiro == data.preparacao.acaoEnfermeiro
            && getAfter(/databases/$(database)/documents/intervencoesBiblioteca/$(data.intervencaoBibliotecaId)).data.destinos == data.preparacao.destinos
            && getAfter(/databases/$(database)/documents/intervencoesBiblioteca/$(data.intervencaoBibliotecaId)).data.modoDisponibilidade == (('modoDisponibilidade' in data.preparacao) ? data.preparacao.modoDisponibilidade : 'resultados_especificos'))
          || (data.status == 'aprovada' && audit.tipo == 'publicar_grupo'
            && 'preparacao' in data && 'intervencaoBibliotecaId' in data && 'grupoOperacaoId' in data
            && audit.grupoOperacaoId == data.grupoOperacaoId
            && audit.intervencaoBibliotecaId == data.intervencaoBibliotecaId
            && getAfter(/databases/$(database)/documents/operacoesDecisoesIntervencoes/$(data.grupoOperacaoId)).data.status == 'preparando'
            && getAfter(/databases/$(database)/documents/operacoesDecisoesIntervencoes/$(data.grupoOperacaoId)).data.sugestaoIds == audit.idsAfetados
            && getAfter(/databases/$(database)/documents/intervencoesBiblioteca/$(data.intervencaoBibliotecaId)).data.status == 'preparando'
            && getAfter(/databases/$(database)/documents/intervencoesBiblioteca/$(data.intervencaoBibliotecaId)).data.acaoPrescrita == data.preparacao.acaoPrescrita
            && getAfter(/databases/$(database)/documents/intervencoesBiblioteca/$(data.intervencaoBibliotecaId)).data.acaoEnfermeiro == data.preparacao.acaoEnfermeiro
            && getAfter(/databases/$(database)/documents/intervencoesBiblioteca/$(data.intervencaoBibliotecaId)).data.destinos == data.preparacao.destinos
            && getAfter(/databases/$(database)/documents/intervencoesBiblioteca/$(data.intervencaoBibliotecaId)).data.modoDisponibilidade == (('modoDisponibilidade' in data.preparacao) ? data.preparacao.modoDisponibilidade : 'resultados_especificos'))
          || (data.status == 'aprovada' && audit.tipo == 'vincular_grupo'
            && 'preparacao' in data && 'intervencaoBibliotecaId' in data && 'grupoOperacaoId' in data
            && audit.grupoOperacaoId == data.grupoOperacaoId && audit.intervencaoBibliotecaId == data.intervencaoBibliotecaId
            && getAfter(/databases/$(database)/documents/operacoesDecisoesIntervencoes/$(data.grupoOperacaoId)).data.status == 'preparando'
            && getAfter(/databases/$(database)/documents/operacoesDecisoesIntervencoes/$(data.grupoOperacaoId)).data.tipo == 'vincular'
            && getAfter(/databases/$(database)/documents/operacoesDecisoesIntervencoes/$(data.grupoOperacaoId)).data.sugestaoIds == audit.idsAfetados
            && getAfter(/databases/$(database)/documents/intervencoesBiblioteca/$(data.intervencaoBibliotecaId)).data.status == 'disponivel'
            && interventionId in getAfter(/databases/$(database)/documents/intervencoesBiblioteca/$(data.intervencaoBibliotecaId)).data.sugestoesOrigemIds
            && getAfter(/databases/$(database)/documents/intervencoesBiblioteca/$(data.intervencaoBibliotecaId)).data.acaoPrescrita == data.preparacao.acaoPrescrita
            && getAfter(/databases/$(database)/documents/intervencoesBiblioteca/$(data.intervencaoBibliotecaId)).data.acaoEnfermeiro == data.preparacao.acaoEnfermeiro
            && getAfter(/databases/$(database)/documents/intervencoesBiblioteca/$(data.intervencaoBibliotecaId)).data.destinos == data.preparacao.destinos
            && getAfter(/databases/$(database)/documents/intervencoesBiblioteca/$(data.intervencaoBibliotecaId)).data.modoDisponibilidade == (('modoDisponibilidade' in data.preparacao) ? data.preparacao.modoDisponibilidade : 'resultados_especificos'))
          || (data.status == 'rejeitada' && audit.tipo == 'rejeitar_grupo'
            && 'grupoOperacaoId' in data && audit.grupoOperacaoId == data.grupoOperacaoId
            && 'categoriaRejeicao' in data && 'justificativaRejeicao' in data && data.justificativaRejeicao.size() > 0
            && audit.justificativa == data.justificativaRejeicao
            && getAfter(/databases/$(database)/documents/operacoesDecisoesIntervencoes/$(data.grupoOperacaoId)).data.status == 'preparando'
            && getAfter(/databases/$(database)/documents/operacoesDecisoesIntervencoes/$(data.grupoOperacaoId)).data.categoria == data.categoriaRejeicao
            && getAfter(/databases/$(database)/documents/operacoesDecisoesIntervencoes/$(data.grupoOperacaoId)).data.justificativa == data.justificativaRejeicao));
    }

    function splitChildAfter(childId, originalId, index) {
      let child = getAfter(/databases/$(database)/documents/intervencoesAutorais/$(childId)).data;
      return child.derivacao.originalId == originalId
        && child.derivacao.grupoId == originalId
        && child.derivacao.ordem == index
        && child.status == 'aguardando';
    }

    function validSplitUpdate(originalId) {
      let data = request.resource.data;
      let split = data.divisao;
      let ids = split.derivadasIds;
      let audit = getAfter(/databases/$(database)/documents/decisoesIntervencoes/$(data.ultimaDecisaoId)).data;
      return !('divisao' in resource.data) && !('derivacao' in resource.data)
        && (!('status' in resource.data) || resource.data.status == 'aguardando')
        && data.diff(resource.data).affectedKeys().hasOnly(['divisao', 'ultimaDecisaoId'])
        && split.keys().hasOnly(['grupoId', 'derivadasIds', 'revisorId', 'revisorNome', 'dataHora'])
        && split.grupoId == originalId && split.revisorId == request.auth.uid
        && boundedString(split.revisorNome, 160) && split.dataHora == request.time
        && ids is list && ids.size() >= 2 && ids.size() <= 5
        && ids[0] == originalId + '-d1' && ids[1] == originalId + '-d2'
        && splitChildAfter(ids[0], originalId, 1) && splitChildAfter(ids[1], originalId, 2)
        && (ids.size() < 3 || (ids[2] == originalId + '-d3' && splitChildAfter(ids[2], originalId, 3)))
        && (ids.size() < 4 || (ids[3] == originalId + '-d4' && splitChildAfter(ids[3], originalId, 4)))
        && (ids.size() < 5 || (ids[4] == originalId + '-d5' && splitChildAfter(ids[4], originalId, 5)))
        && audit.sugestaoId == originalId && audit.tipo == 'desmembrar'
        && audit.statusAnterior == 'aguardando' && audit.statusNovo == 'aguardando'
        && audit.avaliadorId == request.auth.uid && audit.dataHora == request.time;
    }

    function validQualityEvaluation(quality) {
      return quality is map
        && quality.keys().hasAll(['avaliadorId', 'avaliadoEm', 'versaoCriterios'])
        && quality.keys().hasOnly(['atomicidadeStatus', 'especificidadeNivel', 'pertinenciaClinica', 'exequibilidadeNivel', 'reavaliabilidadeNivel', 'alertasSeguranca', 'intensidadeRevisao', 'observacaoTecnica', 'avaliadorId', 'avaliadoEm', 'versaoCriterios'])
        && quality.avaliadorId == request.auth.uid && quality.avaliadoEm == request.time
        && quality.versaoCriterios == 'experimental-v1'
        && (!('atomicidadeStatus' in quality) || quality.atomicidadeStatus in ['unica', 'multiplas_relacionadas', 'multiplas_independentes', 'indeterminada'])
        && (!('especificidadeNivel' in quality) || quality.especificidadeNivel in ['adequada', 'parcial', 'insuficiente'])
        && (!('pertinenciaClinica' in quality) || quality.pertinenciaClinica in ['pertinente', 'condicionada', 'incompativel', 'indeterminada'])
        && (!('exequibilidadeNivel' in quality) || quality.exequibilidadeNivel in ['adequada', 'parcial', 'insuficiente'])
        && (!('reavaliabilidadeNivel' in quality) || quality.reavaliabilidadeNivel in ['adequada', 'parcial', 'insuficiente'])
        && (!('intensidadeRevisao' in quality) || quality.intensidadeRevisao in ['sem_alteracoes', 'ajuste_textual', 'reformulacao_tecnica', 'desmembramento'])
        && (!('alertasSeguranca' in quality) || (quality.alertasSeguranca is list && quality.alertasSeguranca.size() <= 6
          && quality.alertasSeguranca.hasOnly(['medicamentos', 'procedimentos', 'contencao', 'atribuicoes', 'protocolos', 'outros'])) )
        && (!('observacaoTecnica' in quality) || boundedString(quality.observacaoTecnica, 1000));
    }

    function validQualityUpdate(suggestionId) {
      let data = request.resource.data;
      let audit = getAfter(/databases/$(database)/documents/decisoesIntervencoes/$(data.ultimaDecisaoId)).data;
      return data.diff(resource.data).affectedKeys().hasOnly(['avaliacaoQualidade', 'ultimaDecisaoId'])
        && data.diff(resource.data).affectedKeys().hasAll(['avaliacaoQualidade', 'ultimaDecisaoId'])
        && validQualityEvaluation(data.avaliacaoQualidade)
        && audit.sugestaoId == suggestionId && audit.tipo == 'avaliar'
        && audit.avaliacaoQualidade == data.avaliacaoQualidade
        && audit.statusAnterior == (('status' in resource.data) ? resource.data.status : 'aguardando')
        && audit.statusNovo == audit.statusAnterior
        && audit.avaliadorId == request.auth.uid && audit.dataHora == request.time;
    }

    function validDerivedCreate(childId) {
      let data = request.resource.data;
      let link = data.derivacao;
      let original = get(/databases/$(database)/documents/intervencoesAutorais/$(link.originalId)).data;
      let after = getAfter(/databases/$(database)/documents/intervencoesAutorais/$(link.originalId)).data;
      return validSuggestion(data)
        && data.keys().hasOnly(['textoIntervencao', 'tituloResultadoVinculado', 'tituloResultadoOrigem', 'diagnosticoOrigemId', 'tituloDiagnosticoOrigem', 'autorId', 'autorNome', 'autorNomeResolvido', 'status', 'tipoRegistro', 'dataCriacao', 'derivacao'])
        && data.status == 'aguardando' && data.tipoRegistro == 'derivada' && data.dataCriacao == request.time
        && link.keys().hasOnly(['originalId', 'grupoId', 'ordem', 'revisorId', 'dataHora'])
        && boundedString(link.originalId, 120) && link.grupoId == link.originalId
        && link.ordem is int && link.ordem >= 1 && link.ordem <= 5
        && link.revisorId == request.auth.uid && link.dataHora == request.time
        && !('divisao' in original) && !('derivacao' in original)
        && after.divisao.derivadasIds[link.ordem - 1] == childId
        && after.divisao.revisorId == request.auth.uid
        && data.autorId == original.autorId && data.autorNome == original.autorNome
        && (('autorNomeResolvido' in original) ? data.autorNomeResolvido == original.autorNomeResolvido : !('autorNomeResolvido' in data))
        && data.tituloResultadoVinculado == original.tituloResultadoVinculado
        && data.diagnosticoOrigemId == (('diagnosticoOrigemId' in original) ? original.diagnosticoOrigemId : '')
        && data.tituloDiagnosticoOrigem == (('tituloDiagnosticoOrigem' in original) ? original.tituloDiagnosticoOrigem : '')
        && data.tituloResultadoOrigem == (('tituloResultadoOrigem' in original) ? original.tituloResultadoOrigem : '');
    }

    match /intervencoesAutorais/{interventionId} {
      allow get, list: if canManageContent() || (isApproved() && resource.data.autorId == request.auth.uid);
      allow create: if (canManageContent() && validDerivedCreate(interventionId)) || (hasPage('ProcessoEnfermagem') && validSuggestion(request.resource.data)
        && request.resource.data.autorId == request.auth.uid
        && ((request.resource.data.keys().hasOnly(['textoIntervencao', 'tituloResultadoVinculado', 'autorId', 'autorNome', 'dataCriacao']))
          || (request.resource.data.identificadorSugestao == interventionId
            && request.resource.data.status == 'aguardando'
            && request.resource.data.keys().hasOnly(['textoIntervencao', 'tituloResultadoVinculado', 'autorId', 'autorNome', 'autorNomeResolvido', 'origemStatus', 'dataCriacao', 'tituloResultadoOrigem', 'diagnosticoOrigemId', 'tituloDiagnosticoOrigem', 'identificadorSugestao', 'status'])
            && (!('autorNomeResolvido' in request.resource.data) || request.resource.data.autorNomeResolvido == get(profilePath()).data.dadosPessoais.nomeCompleto)
            && (!('origemStatus' in request.resource.data) || request.resource.data.origemStatus == ('diagnosticoOrigemId' in request.resource.data && request.resource.data.diagnosticoOrigemId.size() > 0 ? 'confirmada' : 'nao_recuperavel'))
            && request.resource.data.dataCriacao == request.time)));
      allow update: if canManageContent() && (validSuggestionUpdate(interventionId) || validSplitUpdate(interventionId) || validQualityUpdate(interventionId));
      allow delete: if false;
    }

    function validLibrary(data, libraryId) {
      return data is map
        && data.keys().hasAll(['acaoPrescrita', 'acaoEnfermeiro', 'materiaisDeApoio', 'modoDisponibilidade', 'destinos', 'status', 'versao', 'sugestoesOrigemIds', 'criadoPorUid', 'criadoPorNome', 'criadoEm', 'publicadoEm'])
        && data.keys().hasOnly(['acaoPrescrita', 'acaoEnfermeiro', 'materiaisDeApoio', 'modoDisponibilidade', 'destinos', 'status', 'versao', 'sugestoesOrigemIds', 'grupoOperacaoId', 'ultimaOperacaoVinculoId', 'criadoPorUid', 'criadoPorNome', 'criadoEm', 'publicadoEm'])
        && boundedString(data.acaoPrescrita, 1000) && data.acaoPrescrita.size() > 0
        && boundedString(data.acaoEnfermeiro, 1000) && data.acaoEnfermeiro.size() > 0
        && data.materiaisDeApoio is list && data.materiaisDeApoio.size() <= 20
        && data.modoDisponibilidade in ['resultados_especificos', 'transversal']
        && data.destinos is list && data.destinos.size() <= 1000
        && ((data.modoDisponibilidade == 'transversal' && data.destinos.size() == 0)
          || (data.modoDisponibilidade == 'resultados_especificos' && data.destinos.size() > 0))
        && data.status in ['disponivel', 'preparando'] && data.versao == 1
        && !('ultimaOperacaoVinculoId' in data)
        && data.sugestoesOrigemIds is list && data.sugestoesOrigemIds.size() >= 1 && data.sugestoesOrigemIds.size() <= 100
        && data.criadoPorUid == request.auth.uid && boundedString(data.criadoPorNome, 160) && data.criadoPorNome.size() > 0
        && data.criadoEm == request.time
        && (data.status == 'preparando'
          ? ('grupoOperacaoId' in data && data.publicadoEm == null
            && getAfter(/databases/$(database)/documents/operacoesDecisoesIntervencoes/$(data.grupoOperacaoId)).data.intervencaoBibliotecaId == libraryId
            && getAfter(/databases/$(database)/documents/operacoesDecisoesIntervencoes/$(data.grupoOperacaoId)).data.sugestaoIds == data.sugestoesOrigemIds
            && getAfter(/databases/$(database)/documents/operacoesDecisoesIntervencoes/$(data.grupoOperacaoId)).data.criadoPorUid == request.auth.uid)
          : (data.publicadoEm == request.time
            && getAfter(/databases/$(database)/documents/intervencoesAutorais/$(data.sugestoesOrigemIds[0])).data.intervencaoBibliotecaId == libraryId
            && getAfter(/databases/$(database)/documents/intervencoesAutorais/$(data.sugestoesOrigemIds[0])).data.status == 'aprovada'
            && getAfter(/databases/$(database)/documents/intervencoesAutorais/$(data.sugestoesOrigemIds[0])).data.preparacao.acaoPrescrita == data.acaoPrescrita
            && getAfter(/databases/$(database)/documents/intervencoesAutorais/$(data.sugestoesOrigemIds[0])).data.preparacao.acaoEnfermeiro == data.acaoEnfermeiro
            && getAfter(/databases/$(database)/documents/intervencoesAutorais/$(data.sugestoesOrigemIds[0])).data.preparacao.destinos == data.destinos));
    }

    function validLibraryActivation(libraryId) {
      let data = request.resource.data;
      let operation = getAfter(/databases/$(database)/documents/operacoesDecisoesIntervencoes/$(data.grupoOperacaoId)).data;
      return resource.data.status == 'preparando' && data.status == 'disponivel'
        && data.diff(resource.data).affectedKeys().hasOnly(['status', 'publicadoEm'])
        && data.publicadoEm == request.time && operation.status == 'concluida'
        && operation.intervencaoBibliotecaId == libraryId
        && operation.concluidasIds.hasAll(operation.sugestaoIds);
    }

    function validLibraryLink(libraryId) {
      let data = request.resource.data;
      let operation = getAfter(/databases/$(database)/documents/operacoesDecisoesIntervencoes/$(data.ultimaOperacaoVinculoId)).data;
      return resource.data.status == 'disponivel' && data.status == 'disponivel'
        && data.diff(resource.data).affectedKeys().hasOnly(['sugestoesOrigemIds', 'ultimaOperacaoVinculoId'])
        && data.sugestoesOrigemIds is list && data.sugestoesOrigemIds.size() == resource.data.sugestoesOrigemIds.size() + 1
        && data.sugestoesOrigemIds.size() <= 1000
        && data.sugestoesOrigemIds.hasAll(resource.data.sugestoesOrigemIds)
        && operation.sugestaoIds.hasAny(data.sugestoesOrigemIds)
        && operation.status == 'preparando' && operation.tipo == 'vincular'
        && operation.intervencaoBibliotecaId == libraryId
        && boundedString(data.ultimaOperacaoVinculoId, 128);
    }

    function validDecision(data) {
      return data is map
        && data.keys().hasAll(['sugestaoId', 'statusAnterior', 'statusNovo', 'tipo', 'avaliadorId', 'destinos', 'justificativa', 'dataHora'])
        && data.keys().hasOnly(['sugestaoId', 'statusAnterior', 'statusNovo', 'tipo', 'avaliadorId', 'destinos', 'justificativa', 'avaliacaoQualidade', 'intervencaoBibliotecaId', 'grupoOperacaoId', 'idsAfetados', 'dataHora'])
        && boundedString(data.sugestaoId, 128)
        && data.statusAnterior in ['aguardando', 'aprovada', 'rejeitada']
        && data.statusNovo in ['aguardando', 'aprovada', 'rejeitada']
        && data.tipo in ['preparar', 'publicar', 'rejeitar', 'desmembrar', 'avaliar', 'publicar_grupo', 'rejeitar_grupo', 'vincular_grupo']
        && (data.tipo == 'avaliar' || data.statusAnterior == 'aguardando')
        && (data.tipo != 'avaliar' || data.statusAnterior == data.statusNovo)
        && (data.tipo != 'desmembrar' || data.statusNovo == 'aguardando')
        && (data.tipo == 'avaliar' ? ('avaliacaoQualidade' in data && validQualityEvaluation(data.avaliacaoQualidade)) : !('avaliacaoQualidade' in data))
        && (!(data.tipo in ['avaliar', 'desmembrar']) || (data.destinos.size() == 0 && data.justificativa == ''))
        && (data.tipo in ['publicar_grupo', 'rejeitar_grupo', 'vincular_grupo']
          ? ('grupoOperacaoId' in data && boundedString(data.grupoOperacaoId, 128) && data.idsAfetados is list && data.idsAfetados.size() >= 2 && data.idsAfetados.size() <= 100 && data.sugestaoId in data.idsAfetados)
          : (!('grupoOperacaoId' in data) && !('idsAfetados' in data)))
        && (data.tipo in ['publicar', 'publicar_grupo', 'vincular_grupo'] ? ('intervencaoBibliotecaId' in data && boundedString(data.intervencaoBibliotecaId, 128)) : !('intervencaoBibliotecaId' in data))
        && data.avaliadorId == request.auth.uid
        && data.destinos is list && data.destinos.size() <= 1000
        && boundedString(data.justificativa, 2000)
        && data.dataHora == request.time;
    }

    match /decisoesIntervencoes/{decisionId} {
      allow read: if canManageContent();
      // A sugestão exige este documento no mesmo commit; a direção única evita
      // recursão de getAfter entre as duas regras.
      allow create: if canManageContent() && validDecision(request.resource.data);
      allow update, delete: if false;
    }

    match /intervencoesBiblioteca/{libraryId} {
      allow get, list: if canManageContent() || (isApproved() && resource.data.status == 'disponivel' && hasPage('ProcessoEnfermagem'));
      allow create: if canManageContent() && validLibrary(request.resource.data, libraryId);
      allow update: if canManageContent() && (validLibraryActivation(libraryId) || validLibraryLink(libraryId));
      allow delete: if false;
    }

    match /operacoesDecisoesIntervencoes/{operationId} {
      allow read: if canManageContent();
      allow create: if canManageContent()
        && request.resource.data.keys().hasAll(['tipo', 'status', 'sugestaoIds', 'concluidasIds', 'criadoPorUid', 'criadoPorNome', 'criadoEm'])
        && request.resource.data.keys().hasOnly(['tipo', 'status', 'sugestaoIds', 'concluidasIds', 'intervencaoBibliotecaId', 'categoria', 'justificativa', 'criadoPorUid', 'criadoPorNome', 'criadoEm'])
        && request.resource.data.tipo in ['publicar', 'rejeitar', 'vincular'] && request.resource.data.status == 'preparando'
        && request.resource.data.sugestaoIds is list && request.resource.data.sugestaoIds.size() >= 2 && request.resource.data.sugestaoIds.size() <= 100
        && request.resource.data.concluidasIds is list && request.resource.data.concluidasIds.size() == 0
        && request.resource.data.criadoPorUid == request.auth.uid && boundedString(request.resource.data.criadoPorNome, 160)
        && request.resource.data.criadoEm == request.time
        && (request.resource.data.tipo == 'publicar'
          ? ('intervencaoBibliotecaId' in request.resource.data && !('categoria' in request.resource.data) && !('justificativa' in request.resource.data))
          : request.resource.data.tipo == 'vincular'
            ? ('intervencaoBibliotecaId' in request.resource.data && !('categoria' in request.resource.data) && !('justificativa' in request.resource.data) && get(/databases/$(database)/documents/intervencoesBiblioteca/$(request.resource.data.intervencaoBibliotecaId)).data.status == 'disponivel')
            : (!('intervencaoBibliotecaId' in request.resource.data) && request.resource.data.categoria in ['Já existente no catálogo', 'Outra categoria profissional', 'Não contemplada nos protocolos municipais', 'Fundamentação insuficiente', 'Incompatível com diagnóstico', 'Incompatível com resultado', 'Risco à segurança do paciente', 'Redação incompleta', 'Duplicada', 'Fora do Processo de Enfermagem', 'Outro motivo'] && boundedString(request.resource.data.justificativa, 2000) && request.resource.data.justificativa.size() > 0));
      allow update: if canManageContent()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['concluidasIds', 'status', 'concluidaEm'])
        && request.resource.data.concluidasIds is list && request.resource.data.concluidasIds.size() <= resource.data.sugestaoIds.size()
        && request.resource.data.concluidasIds.hasAll(resource.data.concluidasIds)
        && request.resource.data.concluidasIds.hasOnly(resource.data.sugestaoIds)
        && (request.resource.data.status == 'preparando'
          ? !('status' in resource.data) || resource.data.status == 'preparando'
          : request.resource.data.status == 'concluida' && request.resource.data.concluidasIds.hasAll(resource.data.sugestaoIds) && request.resource.data.concluidaEm == request.time);
      allow delete: if false;
    }

    // Nossa História: coleção e campos preservados desde a versão antiga.
    // Leitura pública somente de conteúdos editoriais, nunca de dados clínicos.
    function validTimelineEvent(data) {
      return data is map
        && data.keys().hasAll(['dataEvento', 'titulo', 'subtitulo', 'textoRedacao', 'foto', 'legendaFoto', 'autoriaFoto'])
        && data.keys().hasOnly(['dataEvento', 'titulo', 'subtitulo', 'textoRedacao', 'foto', 'legendaFoto', 'autoriaFoto', 'createdAt', 'updatedAt', 'criadoPor', 'atualizadoPor'])
        && data.dataEvento is timestamp
        && boundedString(data.titulo, 180) && data.titulo.size() >= 3
        && boundedString(data.subtitulo, 240) && data.subtitulo.size() >= 3
        && boundedString(data.textoRedacao, 12000) && data.textoRedacao.size() >= 10
        && boundedString(data.foto, 2000)
        && (data.foto == '' || data.foto.matches('https://.*'))
        && boundedString(data.legendaFoto, 300)
        && boundedString(data.autoriaFoto, 160)
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp)
        && (!('criadoPor' in data) || boundedString(data.criadoPor, 128))
        && (!('atualizadoPor' in data) || boundedString(data.atualizadoPor, 128));
    }

    match /timelineEvents/{eventId} {
      allow get, list: if true;
      allow create: if isActiveAdmin() && validTimelineEvent(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.criadoPor == request.auth.uid
        && request.resource.data.atualizadoPor == request.auth.uid;
      allow update: if isActiveAdmin() && validTimelineEvent(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'dataEvento', 'titulo', 'subtitulo', 'textoRedacao', 'foto',
          'legendaFoto', 'autoriaFoto', 'updatedAt', 'atualizadoPor'
        ])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.atualizadoPor == request.auth.uid;
      allow delete: if isActiveAdmin();
    }

    // História institucional real: eventos antigos vivem em historiasPortal.
    // Apenas profissionais aprovados leem o registro completo porque curtidasPor
    // e criadoPorUid identificam usuários; não é uma projeção pública anônima.
    function validHistoriaCreate(data) {
      return data is map
        && data.keys().hasAll([
          'titulo', 'descricao', 'dataOrdenacao', 'dataReferencia', 'curtidasPor',
          'criadoEm', 'atualizadoEm', 'criadoPorUid', 'atualizadoPorUid'
        ])
        && data.keys().hasOnly([
          'titulo', 'descricao', 'subtitulo', 'foto', 'legendaFoto', 'autoriaFoto',
          'dataOrdenacao', 'dataReferencia', 'curtidasPor',
          'criadoEm', 'atualizadoEm', 'criadoPorUid', 'atualizadoPorUid'
        ])
        && boundedString(data.titulo, 180) && data.titulo.size() >= 3
        && boundedString(data.descricao, 12000) && data.descricao.size() >= 10
        && data.dataOrdenacao is string
        && data.dataOrdenacao.matches('[0-9]{4}-(0[1-9]|1[0-2])')
        && data.dataReferencia is string
        && data.dataReferencia.matches('(0[1-9]|1[0-2])/[0-9]{4}')
        && (!('subtitulo' in data) || boundedString(data.subtitulo, 240))
        && (!('foto' in data) || (boundedString(data.foto, 2000) && (data.foto == '' || data.foto.matches('https://.*'))))
        && (!('legendaFoto' in data) || boundedString(data.legendaFoto, 300))
        && (!('autoriaFoto' in data) || boundedString(data.autoriaFoto, 160))
        && data.curtidasPor is list && data.curtidasPor.size() == 0
        && data.criadoEm == request.time
        && data.atualizadoEm == request.time
        && data.criadoPorUid == request.auth.uid
        && data.atualizadoPorUid == request.auth.uid;
    }

    function validHistoriaEdit(data) {
      return data.diff(resource.data).affectedKeys().hasOnly([
          'titulo', 'descricao', 'subtitulo', 'foto', 'legendaFoto', 'autoriaFoto',
          'dataOrdenacao', 'dataReferencia', 'atualizadoEm', 'atualizadoPorUid'
        ])
        && boundedString(data.titulo, 180) && data.titulo.size() >= 3
        && boundedString(data.descricao, 12000) && data.descricao.size() >= 10
        && data.dataOrdenacao is string
        && data.dataOrdenacao.matches('[0-9]{4}-(0[1-9]|1[0-2])')
        && data.dataReferencia is string
        && data.dataReferencia.matches('(0[1-9]|1[0-2])/[0-9]{4}')
        && (!('subtitulo' in data) || boundedString(data.subtitulo, 240))
        && (!('foto' in data) || (boundedString(data.foto, 2000) && (data.foto == '' || data.foto.matches('https://.*'))))
        && (!('legendaFoto' in data) || boundedString(data.legendaFoto, 300))
        && (!('autoriaFoto' in data) || boundedString(data.autoriaFoto, 160))
        && data.atualizadoEm == request.time
        && data.atualizadoPorUid == request.auth.uid;
    }

    function validHistoriaLike(data) {
      let prev = resource.data.curtidasPor;
      let next = data.curtidasPor;
      return isApproved()
        && prev is list && next is list
        && next.size() <= 10000
        && data.diff(resource.data).affectedKeys().hasOnly(['curtidasPor'])
        && ((! (request.auth.uid in prev)
          && request.auth.uid in next
          && next.size() == prev.size() + 1 && next.hasAll(prev))
        || ((request.auth.uid in prev)
          && !(request.auth.uid in next)
          && prev.size() == next.size() + 1 && prev.hasAll(next)));
    }

    match /historiasPortal/{storyId} {
      allow get, list: if isApproved();
      allow create: if isActiveAdmin() && validHistoriaCreate(request.resource.data);
      allow update: if (isActiveAdmin() && validHistoriaEdit(request.resource.data))
        || validHistoriaLike(request.resource.data);
      allow delete: if isActiveAdmin();
    }

    // Documentos legais: versões como snapshots imutáveis.
    // O público só lê o snapshot que o ponteiro indica como vigente.
    function legalStatePath(tipo) {
      return /databases/$(database)/documents/documentosLegais/$(tipo);
    }

    function legalRevisionPath(tipo, id) {
      return /databases/$(database)/documents/documentosLegais/$(tipo)/revisoes/$(id);
    }

    function validLegalState(data) {
      return data is map
        && data.keys().hasAll(['publicadaId', 'rascunhoId', 'sequencia', 'ultimaAcao', 'atualizadoPor', 'atualizadoEm'])
        && data.keys().hasOnly(['publicadaId', 'rascunhoId', 'sequencia', 'ultimaAcao', 'atualizadoPor', 'atualizadoEm'])
        && boundedString(data.publicadaId, 100)
        && boundedString(data.rascunhoId, 100)
        && data.sequencia is int && data.sequencia >= 1 && data.sequencia <= 100000
        && data.ultimaAcao in ['criada', 'editada', 'publicada']
        && data.atualizadoPor == request.auth.uid
        && data.atualizadoEm == request.time;
    }

    function validLegalSnapshot(data, tipo) {
      return data is map
        && data.keys().hasAll(['tipo', 'versao', 'revisao', 'situacao', 'operacao', 'anteriorId', 'conteudo', 'autorUid', 'criadoEm'])
        && data.keys().hasOnly(['tipo', 'versao', 'revisao', 'situacao', 'operacao', 'anteriorId', 'conteudo', 'autorUid', 'criadoEm', 'publicadoEm'])
        && data.tipo == tipo
        && data.versao is int && data.versao >= 1 && data.versao <= 100000
        && data.revisao is int && data.revisao >= 0
        && data.situacao in ['rascunho', 'publicada']
        && data.operacao in ['criada', 'editada', 'publicada']
        && boundedString(data.anteriorId, 100)
        && data.conteudo is map
        && data.conteudo.keys().hasAll(['introducao', 'secoes'])
        && data.conteudo.keys().hasOnly(['introducao', 'secoes'])
        && boundedString(data.conteudo.introducao, 20000)
        && data.conteudo.secoes is list
        && data.conteudo.secoes.size() >= 1 && data.conteudo.secoes.size() <= 25
        && data.autorUid == request.auth.uid
        && data.criadoEm == request.time
        && (data.situacao == 'publicada'
          ? ('publicadoEm' in data && data.publicadoEm == request.time)
          : !('publicadoEm' in data));
    }

    function canCreateLegalVersion(tipo, data) {
      let revision = getAfter(legalRevisionPath(tipo, data.rascunhoId)).data;
      return resource.data.rascunhoId == ''
        && resource.data.publicadaId != ''
        && data.publicadaId == resource.data.publicadaId
        && data.sequencia == resource.data.sequencia + 1
        && data.ultimaAcao == 'criada'
        && revision.operacao == 'criada' && revision.situacao == 'rascunho'
        && revision.versao == data.sequencia && revision.revisao == 0
        && revision.anteriorId == resource.data.publicadaId
        && revision.conteudo == get(legalRevisionPath(tipo, resource.data.publicadaId)).data.conteudo;
    }

    function canEditLegalDraft(tipo, data) {
      let previous = get(legalRevisionPath(tipo, resource.data.rascunhoId)).data;
      let next = getAfter(legalRevisionPath(tipo, data.rascunhoId)).data;
      return resource.data.rascunhoId != ''
        && data.rascunhoId != resource.data.rascunhoId
        && data.publicadaId == resource.data.publicadaId
        && data.sequencia == resource.data.sequencia
        && data.ultimaAcao == 'editada'
        && previous.situacao == 'rascunho'
        && next.situacao == 'rascunho' && next.operacao == 'editada'
        && next.anteriorId == resource.data.rascunhoId
        && next.versao == previous.versao
        && next.revisao == previous.revisao + 1;
    }

    function canPublishLegalDraft(tipo, data) {
      let previous = get(legalRevisionPath(tipo, resource.data.rascunhoId)).data;
      let next = getAfter(legalRevisionPath(tipo, data.publicadaId)).data;
      return resource.data.rascunhoId != ''
        && data.rascunhoId == ''
        && data.publicadaId != resource.data.publicadaId
        && data.sequencia == resource.data.sequencia
        && data.ultimaAcao == 'publicada'
        && previous.situacao == 'rascunho'
        && next.situacao == 'publicada' && next.operacao == 'publicada'
        && next.anteriorId == resource.data.rascunhoId
        && next.conteudo == previous.conteudo
        && next.versao == previous.versao && next.revisao == previous.revisao + 1;
    }

    match /documentosLegais/{tipo} {
      allow get: if tipo in ['terms', 'privacy'];
      allow list, delete: if false;
      allow create: if tipo in ['terms', 'privacy']
        && isActiveAdmin()
        && validLegalState(request.resource.data)
        && request.resource.data.publicadaId == ''
        && request.resource.data.rascunhoId != ''
        && request.resource.data.sequencia == 1
        && request.resource.data.ultimaAcao == 'criada'
        && getAfter(legalRevisionPath(tipo, request.resource.data.rascunhoId)).data.versao == 1
        && getAfter(legalRevisionPath(tipo, request.resource.data.rascunhoId)).data.revisao == 0
        && getAfter(legalRevisionPath(tipo, request.resource.data.rascunhoId)).data.situacao == 'rascunho';
      allow update: if tipo in ['terms', 'privacy']
        && isActiveAdmin()
        && validLegalState(request.resource.data)
        && (canCreateLegalVersion(tipo, request.resource.data)
          || canEditLegalDraft(tipo, request.resource.data)
          || canPublishLegalDraft(tipo, request.resource.data));

      match /revisoes/{revisionId} {
        allow get: if isActiveAdmin() || (
          resource.data.situacao == 'publicada'
          && get(legalStatePath(tipo)).data.publicadaId == revisionId
        );
        allow list: if isActiveAdmin();
        allow create: if tipo in ['terms', 'privacy']
          && isActiveAdmin()
          && validLegalSnapshot(request.resource.data, tipo)
          && (request.resource.data.situacao == 'publicada'
            ? (request.resource.data.operacao == 'publicada'
              && getAfter(legalStatePath(tipo)).data.publicadaId == revisionId)
            : (request.resource.data.operacao in ['criada', 'editada']
              && getAfter(legalStatePath(tipo)).data.rascunhoId == revisionId))
          && (request.resource.data.operacao != 'criada'
            || request.resource.data.revisao == 0);
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
